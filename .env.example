# Native Windows/Linux Node service. Start Kameleo separately for native usage.
KAMELEO_URL=http://127.0.0.1:5050
HOST=127.0.0.1
PORT=3180
MAX_CONCURRENCY=1
RUN_TIMEOUT_MS=600000
EXPORT_DIR=profiles
AUTOMATIONS_DIR=automations
# Leave blank to generate a private .workbench/admin-token on first start.
WORKBENCH_TOKEN=
# Docker Compose only. Do not commit a populated .env.
KAMELEO_PAT=
VNC_PASSWORD=
POSTGRES_PASSWORD=
# Same value on every node sharing one Kameleo team quota.
KAMELEO_TEAM_KEY=
KAMELEO_BROWSER_BUDGET=1
# Enables the included test sign-in flow in Compose.
ENABLE_TEST_FIXTURE=true
FIXTURE_ORIGIN=http://workbench:3180
# Native coordinated mode: point DATABASE_URL at your PostgreSQL server.
# DATABASE_URL=postgresql://workbench:password@127.0.0.1:5432/workbench
# FLOW_POLICIES_FILE=./flow-policies.mjs
# WORKBENCH_NODE_ID=stable-uuid-for-this-engine
# WORKBENCH_TENANT_ID=stable-workspace-uuid
# IDLE_TIMEOUT_MS=180000
# Set the exact HTTPS origin when running behind a reverse proxy.
PUBLIC_ORIGIN=
# Optional native/remote settings:
# KAMELEO_EXPORT_DIR=C:\absolute\path\to\profiles
# KAMELEO_VNC_URL=ws://private-engine-host/websockify
# PROXY_INVENTORY_FILE=proxy-inventory.json
# EMBED_ORIGINS=https://your-owned-app.example
